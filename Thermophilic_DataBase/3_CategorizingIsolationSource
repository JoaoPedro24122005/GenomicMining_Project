#!/usr/bin/env bash

# Created by Gemini
# 2026-03-28

# --- Source Utility Functions ---
source "./UtilityFunctions/ErrorMessage.sh"
source "./UtilityFunctions/DateFunction.sh"

# --- Color Definitions ---
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m' 

# 1 - Setup Environment and Directories
if [ -z "$1" ]; then
    echo -e "${YELLOW}Usage: ${0##*/} <input_file>${NC}"
    exit 1
fi

INPUT_PATH=$(realpath "$1")
INPUT_BASE=$(basename "$1")
TIMESTAMP="$(date +"%Y-%m-%d_%H-%M-%S")"

SCRIPT_NAME="${0##*/}"
WORK_DIR="ResultFiles/${SCRIPT_NAME%.sh}"
mkdir -p "$WORK_DIR"
cd "$WORK_DIR" || { echo "Can't move to Working Directory: $WORK_DIR"; exit 1; }

OUTPUT="Categorized-$INPUT_BASE"

# 2 - Processing Starts
TOTAL_LINES=$(wc -l < "$INPUT_PATH")
echo -e "${CYAN}[INFO] Categorizing file: $INPUT_BASE ($TOTAL_LINES lines)${NC}"

# 3 - Define Keyword Patterns (Regex)
CLASS1="thermal|thermophilic|volcan|black smoker|hotspring|hot (spring|water|region|stream|underground|marine|pool|tub|aquifer|river|sediment|lake|area|climate|well)|freshwater hot|boiling|boiler|boil drainage|oilfield|oil reservoir|solfataric|steam vent|richmond mine|high-temperature|high temperature|acid mine drainage|[4-9][0-9]( deg|C)|[^A-Z^a-z]|^)heat[^h]" 
CLASS2="feces|fecal|faecal|rumen|ruminant|gut|mine tailings"
CLASS3="cold|frost|frozen|low temperature|low-temperature"

# 4 - Classification Logic using AWK
echo -e "${GREEN}[STEP 1/1] Classifying assemblies based on Isolation Source (Col 10)...${NC}"

# We use an associative array "count" to track totals
awk -F'\t' -v OFS='\t' -v c1="$CLASS1" -v c2="$CLASS2" -v c3="$CLASS3" '
BEGIN { 
    IGNORECASE = 1 
    # Initialize counters to zero
    count["Thermophile"] = 0
    count["Thermotolerant"] = 0
    count["Non-Thermophile"] = 0
    count["Undetermined"] = 0
}
NR == 1 { 
    print $0, "IsolationSource_Classification", "IsolationSource_Keyword"; 
    next; 
}
{
    classification = "Undetermined";
    keyword = "NULL";
    val = tolower($10);

    if (match(val, c1)) {
        classification = "Thermophile";
        keyword = substr(val, RSTART, RLENGTH);
    } else if (match(val, c2)) {
        classification = "Thermotolerant";
        keyword = substr(val, RSTART, RLENGTH);
    } else if (match(val, c3)) {
        classification = "Non-Thermophile";
        keyword = substr(val, RSTART, RLENGTH);
    }

    # Increment the counter for the assigned classification
    count[classification]++;
    
    print $0, classification, keyword;
}
END {
    # Print the summary to stderr so it shows in the console but doesnt mess up the redirected file output
    print "\n--- CLASSIFICATION SUMMARY ---" > "/dev/stderr"
    printf "%-20s : %d\n", "Thermophile", count["Thermophile"] > "/dev/stderr"
    printf "%-20s : %d\n", "Thermotolerant", count["Thermotolerant"] > "/dev/stderr"
    printf "%-20s : %d\n", "Non-Thermophile", count["Non-Thermophile"] > "/dev/stderr"
    printf "%-20s : %d\n", "Undetermined", count["Undetermined"] > "/dev/stderr"
    print "------------------------------" > "/dev/stderr"
}' "$INPUT_PATH" > "temp_output.tmp"

mv "temp_output.tmp" "$OUTPUT"

# 5 - Final Summary
FINAL_LINES=$(wc -l < "$OUTPUT")
echo -e "${CYAN}[COMPLETE] Classification finished.${NC}"
echo -e "${CYAN}[OUTPUT LOCATION] $WORK_DIR/$OUTPUT${NC}"