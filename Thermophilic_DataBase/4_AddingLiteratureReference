#!/usr/bin/env bash

# Created by Gemini
# 2026-03-29

if [ "$#" -ne 2 ]; then
    # Adding local color definitions for the usage message
    YELLOW='\033[1;33m'
    NC='\033[0m'
    echo -e "${YELLOW}Usage: $0 <INPUT_FILE> <LITERATURE_FILE>${NC}"
    exit 1
fi

INPUT_PATH=$(realpath "$1")
INPUT_BASE=$(basename "$1")
LIT_FILE=$(realpath "$2") # remove the HEADER
TIMESTAMP="$(date +"%Y-%m-%d_%H-%M-%S")"

SCRIPT_NAME="${0##*/}"
WORK_DIR="ResultFiles/${SCRIPT_NAME%.sh}"
mkdir -p "$WORK_DIR"
cd "$WORK_DIR" || { echo "Can't move to Working Directory: $WORK_DIR"; exit 1; }

OUTPUT="Referenced-$INPUT_BASE"
TAX_FILE="Taxonomy-$INPUT_BASE"

# --- Color Definitions ---
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${CYAN}Starting analysis using taxonkit reformat2...${NC}"

# 1. Generate Batch Taxonomy Mapping (Unique IDs only for efficiency)
echo -e "${CYAN}Mapping TaxIDs to lineage...${NC}"
tail -n +2 "$INPUT_PATH" | cut -f3 | sort -u | \
taxonkit reformat2 -I 1 -t | cut -f1,3 | tr ';' '\t' > "temp_tax_mapping.txt" # The taxonomy temp file only contain the TaxID of the taxonomy (easier to compare than taxon names)

# 2. Prepare Headers
HEADER=$(head -n 1 "$INPUT_PATH")
echo -e "${HEADER}\tLiterature_Reference" > "$OUTPUT"
echo -e "Organism_Name\tTaxID\tKingdom\tPhylum\tClass\tOrder\tFamily\tGenus\tSpecies" > "$TAX_FILE"

# 3. High-Performance Processing
# We use a single awk command to load literature and mapping into memory
echo -e "${CYAN}Processing entries and matching literature references...${NC}"

awk -F'\t' -v tax_file="$TAX_FILE" '
    # Load Literature File into memory
    FILENAME == ARGV[1] && FNR > 1 {
        # Strip trailing whitespace from the reference column
        Lit_TaxID = $3
        ref_url = $2
        gsub(/[ \t]+$/, "", ref_url)
        ref[Lit_TaxID] = ref_url
        next
    }
    # Load TaxonKit Mapping into memory
    FILENAME == ARGV[2] {
        # map[TaxID] = Full reformat2 row
        map[$1] = $0
        next
    }
    # Process Main Input File
    FNR > 1 {
        taxid = $3
        org_name = $2
        
        if (taxid in map) {
            # Extract ranks (Col 2 to 8 of the reformat2 output)
            split(map[taxid], ranks, "\t")
            
            # Save to Taxonomy file (ranks are index 2 to 8)
            printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", 
                org_name, taxid, ranks[2], ranks[3], ranks[4], ranks[5], ranks[6], ranks[7], ranks[8] >> tax_file
            
            # Hierarchical search (Species [8] down to Kingdom [2])
            found_ref = "No Reference Founded"
            for (i=8; i>=2; i--) {
                current_taxon = ranks[i]
                if (current_taxon != "" && current_taxon in ref) {
                    found_ref = ref[current_taxon]
                    break
                }
            }
            print $0 "\t" found_ref
        } else {
            # Error Case
            print $0 "\tERROR - Taxonomy Not Founded"
        }
    }
' "$LIT_FILE" "temp_tax_mapping.txt" "$INPUT_PATH" >> "$OUTPUT"

# Cleanup
rm temp_tax_mapping.txt

echo -e "${GREEN}Analysis complete!${NC}"
echo -e "${CYAN}Check $OUTPUT and $TAX_FILE in $WORK_DIR${NC}"